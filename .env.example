# Intelligent HR HelpDesk - Environment Variables Template
# Copy this file to .env for local testing

FLASK_ENV=development
PORT=5000

# Azure AI Foundry / Azure OpenAI Credentials
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_AI_API_KEY=your-azure-ai-api-key
AZURE_AI_MODEL=mistral-small-2503

# Azure SQL Server Credentials
AZURE_SQL_HOST=sql-hr-helpdesk-dev.database.windows.net
AZURE_SQL_HOT_DB=sqldb-hot-helpdesk
AZURE_SQL_ARCHIVE_DB=sqldb-archive-helpdesk
AZURE_SQL_USER=hradmin_dev
AZURE_SQL_PASSWORD=YourStrongPassword123!

# Azure Storage Account
AZURE_STORAGE_ACCOUNT=sthrhelpdeskdev
AZURE_STORAGE_CONTAINER=tickets-attachments

# Azure Application Insights Monitoring
APPINSIGHTS_INSTRUMENTATIONKEY=your-appinsights-instrumentation-key
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://eastus-0.in.applicationinsights.azure.com/
